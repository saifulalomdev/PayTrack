{
	"name": "trackflow",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": [
		"nodejs_compat_v2",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "paytrack",
			"database_id": "80c4fd64-37e2-4c72-8141-b28bc1f1ec89",
			"migrations_dir": "./drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "82ef8b0eb93945d683b2bd2375acd318"
		}
	],
	"observability": {
		"enabled": true
	}
}