---
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
const staff = Astro.locals.staff!;
---

<MainLayout>
    <DashboardLayout
        client:load
        transition:persist
        staff={{ name: staff.name, role: staff.role }}
    >
        customer content
    </DashboardLayout>
</MainLayout>
