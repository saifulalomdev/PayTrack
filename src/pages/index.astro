---
// src/pages/index.astro
import DefaultLayout from "@/layouts/default.astro";
import { DashboardMetricsCard } from "@/modules/dashboard/components/dashboard-metrics-card";
import { DailyCollectionsTable } from "@/modules/dashboard/components/daily-collections-table";
import { dashboardService } from "@/modules/dashboard/dashboard-service";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";
import { safeFetch } from "@/utils/safe-fetch";

// Get from middleware
const lang = Astro.locals.lang;
const t = Astro.locals.t;

// Get page and limit
const pageParam = Astro.url.searchParams.get("page");
const limitParam = Astro.url.searchParams.get("limit");

const page = pageParam ? Math.max(1, parseInt(pageParam, 10)) : 1;
const limit = limitParam ? Math.max(1, parseInt(limitParam, 10)) : 10;
const offset = (page - 1) * limit;

const db = getDb(env);

const { data: metrics, error: errMsg } = await safeFetch(() =>
  dashboardService.getDashboardMetrics(db)
);

const { data: dailyData, error: dailyErrorMsg } = await safeFetch(() =>
  dashboardService.getDailyCollections(db, limit, offset)
);

const collections = dailyData?.items ?? [];
const totalDays = dailyData?.totalCount ?? 0;
const totalPages = Math.ceil(totalDays / limit) || 1;
---

<DefaultLayout>
  <div class="space-y-6">
    <DashboardMetricsCard 
      metrics={metrics} 
      errorMsg={errMsg}
      lang={lang}
      t={t}
    />

    <DailyCollectionsTable 
      collections={collections}
      currentPage={page}
      totalPages={totalPages}
      limit={limit}
      errorMsg={dailyErrorMsg}
      lang={lang}
      t={t}
    />
  </div>
</DefaultLayout>