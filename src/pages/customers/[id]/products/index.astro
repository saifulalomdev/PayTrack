---
// src/pages/customers/[id]/products/index.astro
import { ProductManager } from "@/modules/product/components/product-manager";
import { customerService } from "@/modules/customer/customer-service";
import MainLayout from "@/layouts/main.astro";
import { safeFetch } from "@/utils/safe-fetch";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";

const { id: customerId } = Astro.params;

if (!customerId) {
    return Astro.redirect("/customers");
}
const { data: customer, error: errMsg } = await safeFetch(() =>
    customerService.getById(getDb(env), customerId),
);
---

<MainLayout>
    <ProductManager
        errorMsg={errMsg}
        customerName={customer?.name}
        serialNumber={customer?.serialNumber}
        customerId={customerId}
        client:load
    />
</MainLayout>
