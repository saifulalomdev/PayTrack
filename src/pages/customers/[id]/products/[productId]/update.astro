---
// src/pages/customers/[id]/products/[productId]/update.astro
import { ProductUpdate } from "@/modules/product/components/product-update";
import { productService } from "@/modules/product/product-service";
import { safeFetch } from "@/utils/safe-fetch";
import MainLayout from "@/layouts/main.astro";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";

const { id: customerId, productId } = Astro.params;

if (!customerId || !productId) {
    return Astro.redirect("/customers");
}

const { data: productData, error: errMsg } = await safeFetch(() =>
    productService.getById(getDb(env), productId),
);
---

<MainLayout>
    <ProductUpdate
        client:load
        customerId={customerId}
        productData={productData as any}
        errorMsg={errMsg}
    />
</MainLayout>