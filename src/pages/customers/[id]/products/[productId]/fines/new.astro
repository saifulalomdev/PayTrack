---
// src/pages/customers/[id]/products/[productId]/fines/new.astro
import DefaultLayout from "@/layouts/default.astro";
import { FineAdd } from "@/modules/fine/components/fine-add";

const { id: customerId, productId } = Astro.params;

if (!productId || !customerId) {
    return Astro.redirect("/");
}
---

<DefaultLayout>
    <FineAdd client:load customerId={customerId} productId={productId} />
</DefaultLayout>