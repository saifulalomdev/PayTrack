---
// src/pages/customers/[id]/products/[productId]/index.astro
import { productService } from "@/modules/product/product-service";
import { installmentService } from "@/modules/installment/installment-service";
import { safeFetch } from "@/utils/safe-fetch";
import DefaultLayout from "@/layouts/default.astro";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";

const { id: customerId, productId } = Astro.params;

if (!customerId || !productId) {
    return Astro.redirect("/customers");
}

const { data: balance, error: errMsg } = await safeFetch(() =>
    installmentService.getBalance(getDb(env), productId),
);
---

<DefaultLayout>
</DefaultLayout>