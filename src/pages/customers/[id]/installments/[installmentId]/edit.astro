---
// src/pages/customers/[id]/installments/[installmentId]/edit.astro
import { installmentService } from "@/modules/installment/installment.service";
import { EditInstallment } from "@/modules/installment/components/edit";
import { DashboardLayout } from "@/layouts/layout";
import { safeFetch } from "@/utils/safe-fetch";
import MainLayout from "@/layouts/main.astro";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";

// NOTE: this route used to live at
// customers/[id]/installments/[id]/edit.astro — TWO segments both named
// "id". Astro.params is a flat object keyed by name, so that collision
// meant only one of {customerId, installmentId} was ever actually
// readable at runtime; the other got silently clobbered. Renaming this
// segment to [installmentId] fixes it.
const { id: customerId, installmentId } = Astro.params;

if (!customerId || !installmentId) {
    return Astro.redirect("/customers");
}

// context.locals.staff is populated by the auth middleware and guaranteed
// non-null here, since this route sits behind the auth guard.
const currentStaff = Astro.locals.staff!;

// Editing an installment is admin-only. Staff can add installments but
// must never reach this route — bounce them out server-side rather than
// relying only on the UI hiding the edit button. The updateInstallment
// action also enforces requireAdmin itself, so this is defense in depth,
// not the only gate.
if (currentStaff.role !== "admin") {
    return Astro.redirect(`/customers/${customerId}/installments`);
}

const { data: installmentData, error: errMsg } = await safeFetch(() =>
    installmentService.getById(getDb(env), installmentId)
);
---

<MainLayout>
    <DashboardLayout
        client:load
        staff={{ name: currentStaff.name, role: currentStaff.role }}
    >
        <EditInstallment client:load installmentData={installmentData as any} errorMsg={errMsg} />
    </DashboardLayout>
</MainLayout>