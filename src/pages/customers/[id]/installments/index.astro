---
// src/pages/customers/[id]/installments/index.astro
import MainLayout from "@/layouts/main.astro";
import { customerService } from "@/modules/customer/customer-service";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";
import { safeFetch } from "@/utils/safe-fetch";

const { id: customerId } = Astro.params;

if (!customerId) {
    return Astro.redirect("/customers");
}

// context.locals.staff is populated by the auth middleware and guaranteed
// non-null here, since this route sits behind the auth guard.
const currentStaff = Astro.locals.staff!;

// This page IS the customer's detail view now — the whole CustomerCard
// on /customers links straight here, so we need the customer record
// itself (for CustomerDetailsCard), not just their installments.
const { data: customerData, error: customerErrMsg } = await safeFetch(() =>
    customerService.getById(getDb(env), customerId),
);
---

<MainLayout>
  
</MainLayout>
