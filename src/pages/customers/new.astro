---
// src/pages/customer/new.astro
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
import { AddNewCustomer } from "@/modules/customer/components/add-form";

// context.locals.staff is populated by the auth middleware and guaranteed
// non-null here, since this route sits behind the auth guard. No admin
// check needed — any logged-in staff can add a customer.
const staff = Astro.locals.staff!;
---

<MainLayout>
    <DashboardLayout
        client:load
        staff={{ name: staff.name, role: staff.role }}
    >
        <AddNewCustomer client:load />
    </DashboardLayout>
</MainLayout>