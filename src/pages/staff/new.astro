---
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
import { AddNewStaff } from "@/modules/staff/components/add-new-staff";
const staff = Astro.locals.staff!;
---

<MainLayout>
    <DashboardLayout
        client:load
        staff={{ name: staff.name, role: staff.role }}
    >
        <AddNewStaff client:load />
    </DashboardLayout>
</MainLayout>
