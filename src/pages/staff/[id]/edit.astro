---
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
import { EditStaff } from "@/modules/staff/components/edit-staff";
import { safeFetch } from "@/utils/safe-fetch";
import { staffRepository } from "@/modules/staff/staff.repository";
import { getDb } from "@/utils";
import { env } from "cloudflare:workers";

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/staff");
}

// Pass a function to safeFetch
const {
    data: { password, ...staffData },
    error: errMsg,
} = await safeFetch(() => staffRepository.findById(getDb(env), id));
---

<MainLayout>
    <DashboardLayout client:load transition:persist>
        <EditStaff client:load staffData={staffData} errorMsg={errMsg} />
    </DashboardLayout>
</MainLayout>
