---
// src/pages/index.astro
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
import { StaffManager } from "@/modules/staff/components/staff-manager";
import { staffService } from "@/modules/staff/staff.service";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";
import { safeFetch } from "@/utils/safe-fetch";

const { data: staff, error: errMsg } = await safeFetch(() =>
  staffService.listAll(getDb(env))
);
---

<MainLayout>
    <DashboardLayout client:load transition:persist>
        <StaffManager client:load errorMsg={errMsg} staff={staff} />
    </DashboardLayout>
</MainLayout>