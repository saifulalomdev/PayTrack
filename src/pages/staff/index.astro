---
// src/pages/staff/index.astro
import MainLayout from "@/layouts/main.astro";
import { DashboardLayout } from "@/layouts/layout";
import { StaffManager } from "@/modules/staff/components/staff-manager";
import { staffService } from "@/modules/staff/staff.service";
import { env } from "cloudflare:workers";
import { getDb } from "@/utils";
import { safeFetch } from "@/utils/safe-fetch";

// context.locals.staff is populated by the auth middleware and guaranteed
// non-null here, since this route sits behind the auth guard.
const currentStaff = Astro.locals.staff!;

const { data: staffList, error: errMsg } = await safeFetch(() =>
  staffService.listAll(getDb(env))
);
---

<MainLayout>
    <DashboardLayout
        client:load
        staff={{ name: currentStaff.name, role: currentStaff.role }}
    >
        <StaffManager client:load errorMsg={errMsg} staff={staffList} />
    </DashboardLayout>
</MainLayout>