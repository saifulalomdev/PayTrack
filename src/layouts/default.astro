---
import { DashboardLayout } from "@/layouts/layout";
import BaseLayout from "./base.astro";
const staff = Astro.locals.staff!;
const { theme } = Astro.locals;
const lang = Astro.locals.lang;
---

<BaseLayout>
    <DashboardLayout
        client:load
        staff={{ name: staff.name, role: staff.role }}
        theme={theme}
        lang={lang}
    >
        <slot />
    </DashboardLayout>
</BaseLayout>
